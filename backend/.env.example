# Example environment variables for ChatApp backend
# Copy this file to `.env` and replace placeholder values with real secrets

# MongoDB connection string
MONGODB_URI=your_mongodb_connection_string

# Server port
PORT=3001

# Frontend origin (for CORS)
FRONTEND_URL=https://your-production-frontend.com

# JWT signing secret (use a long random value)
JWT_SECRET=replace_with_a_strong_random_secret

# Node environment
NODE_ENV=production

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Gmail App Password) credentials used for sending verification/reset emails
# Use your Gmail address and a Google App Password, not your normal Gmail password.
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_google_app_password
EMAIL_FROM=ChatApp <your_email@gmail.com>

# Encryption key (use 32 bytes hex/base64)
ENCRYPTION_KEY=replace_with_a_32_byte_hex_or_base64_key
