# Example environment variables for ChatApp backend
# Copy this file to `.env` and replace placeholder values with real secrets

# MongoDB connection string
MONGODB_URI=your_mongodb_connection_string

# Server port
PORT=3001

# Frontend origin (for CORS)
FRONTEND_URL=https://your-production-frontend.com

# JWT signing secret (use a long random value)
JWT_SECRET=replace_with_a_strong_random_secret

# Node environment
NODE_ENV=production

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (SMTP) credentials used for sending verification/reset emails
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password

# Encryption key (use 32 bytes hex/base64)
ENCRYPTION_KEY=replace_with_a_32_byte_hex_or_base64_key
# Backend Environment Variables
MONGODB_URI=your_mongodb_connection_string

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Message Encryption Key (Must be exactly 32 bytes/64 hex characters)
# You can generate one in node using: require('crypto').randomBytes(32).toString('hex')
ENCRYPTION_KEY=your_64_character_hex_encryption_key

# Cloudinary (for profile pictures)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Frontend URL (for password reset link)
FRONTEND_URL=http://localhost:5173

# Port
PORT=5000
