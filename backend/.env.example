# Example environment variables for ChatApp backend
# Copy this file to `.env` and replace placeholder values with real secrets

# MongoDB connection string
MONGODB_URI=your_mongodb_connection_string

# Server port
PORT=3001

# Frontend origin (for CORS)
FRONTEND_URL=https://your-production-frontend.com

# JWT signing secret (use a long random value)
JWT_SECRET=replace_with_a_strong_random_secret

# Node environment
NODE_ENV=production

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email credentials used for sending verification/reset emails
# Hosted providers like Render often block SMTP ports. For hosted deployments,
# prefer BREVO_API_KEY, RESEND_API_KEY, or SENDGRID_API_KEY because they use HTTPS instead of SMTP.
# BREVO_API_KEY=your_brevo_api_key
# RESEND_API_KEY=your_resend_api_key
# SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=ChatApp <your_verified_sender_email>

# Local SMTP / Gmail App Password fallback
# Use a Google App Password, not your normal Gmail password.
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_google_app_password

# Encryption key (use 32 bytes hex/base64)
ENCRYPTION_KEY=replace_with_a_32_byte_hex_or_base64_key
